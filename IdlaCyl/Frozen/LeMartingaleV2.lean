/-
Lemma `le:martingale` (harmonic martingale) as a faithful `Frozen` statement,
`tex:687-691`.  Its printed proof at `tex:693-705` is discharged by
`harmonicMartingale_isMartingale'`.

The printed lemma reads:

  Let `ψ : 𝔾_N → ℝ` be a discrete harmonic function with the zero horizontal
  average property (eq:zero_average) and exponential decay as `y → -∞`, let
  `(A(t))_{t ≥ 0}` be an IDLA process on `𝔾_N` with `A(0) = R_0`, and let
  `M(t) := (1/N) ⟪D_t, ψ⟫ = (1/N) ∑_{(x,y) ∈ A_+(t)} ψ(x,y)` for `t ≥ 0`.  Then
  `(M(t))_{t ≥ 0}` is a martingale with respect to the natural filtration of the
  IDLA process.

`M(t)` is `harmonicMartingale`, the normalised sum of `ψ` over the first `t`
settling sites, which are almost surely the distinct sites of `A_+(t)`
(`harmonicMartingale_eq_pairing`); the filtration is `idlaFiltration`, the one
generated by the settling sites.  The three hypotheses are `DiscreteHarmonic`,
`ZeroHorizontalAverage` (eq:zero_average) and `ExpDecayBelow`.
-/
import IdlaCyl.Support.HarmonicMartingaleIntegrable

namespace IdlaCyl.Frozen

-- FROZEN-STATEMENT-BEGIN
theorem le_martingale_v2 (B : Base) (ψ : Site B → ℝ)
    (hharm : DiscreteHarmonic B ψ) (hzero : ZeroHorizontalAverage B ψ)
    (hdecay : ExpDecayBelow B ψ) :
    MeasureTheory.Martingale (harmonicMartingale B ψ) (idlaFiltration B) (idlaMeasure B)
-- FROZEN-STATEMENT-END
  := harmonicMartingale_isMartingale' B ψ hharm hzero hdecay

namespace LeMartingaleV2Examples

open IdlaCyl.HarmonicMartingaleIntegrableExamples

/-- The zero function has zero horizontal average. -/
theorem zero_zeroHorizontalAverage (B : Base) :
    ZeroHorizontalAverage B (fun _ => (0 : ℝ)) := by
  intro y
  simp

/-- The zero function decays exponentially downwards. -/
theorem zero_expDecayBelow (B : Base) :
    ExpDecayBelow B (fun _ => (0 : ℝ)) := by
  unfold ExpDecayBelow
  refine ⟨1, 1, one_pos, fun p _ => ?_⟩
  simp only [abs_zero]
  positivity

/-- Nonvacuity, zero case: `ψ = 0` is harmonic, has zero horizontal average and
decays, so `le_martingale_v2` applies to it. -/
example : MeasureTheory.Martingale
    (harmonicMartingale twoVertexBase (fun _ => (0 : ℝ)))
    (idlaFiltration twoVertexBase) (idlaMeasure twoVertexBase) :=
  le_martingale_v2 twoVertexBase (fun _ => (0 : ℝ))
    (discreteHarmonic_const twoVertexBase 0)
    (zero_zeroHorizontalAverage twoVertexBase)
    (zero_expDecayBelow twoVertexBase)

/-- The lazy walk on `K₂` has degree one. -/
theorem twoVertexBase_deg : twoVertexBase.deg = 1 := by
  rw [← twoVertexBase.degree_eq (0 : Fin 2)]
  decide

/-- The lazy kernel on `K₂` is `1/2` everywhere. -/
theorem twoVertexBase_P (x x' : Fin 2) : twoVertexBase.P x x' = 1 / 2 := by
  unfold Base.P
  rw [twoVertexBase_deg]
  fin_cases x <;> fin_cases x' <;> simp [twoVertexBase]

/-- `(1, -1)` is an eigenvector of the lazy kernel with eigenvalue `0`. -/
theorem twoVertex_eig (x : Fin 2) :
    ∑ x' : Fin 2, twoVertexBase.P x x' * (![1, -1] : Fin 2 → ℝ) x'
      = 0 * (![1, -1] : Fin 2 → ℝ) x := by
  simp [twoVertexBase_P, Fin.sum_univ_two]

/-- The mode of `(1, -1)` with eigenvalue `0` and rate `q = arcosh 2`
(so `cosh q = 2 - 0`) is discrete harmonic. -/
theorem twoVertexMode_harmonic :
    DiscreteHarmonic twoVertexBase
      (exponentialMode twoVertexBase (![1, -1] : Fin 2 → ℝ) (Real.arcosh 2) 0) :=
  exponentialMode_harmonic twoVertexBase (![1, -1] : Fin 2 → ℝ) 0 (Real.arcosh 2) 0
    twoVertex_eig (by rw [Real.cosh_arcosh (by norm_num)]; norm_num)

/-- The mode of `(1, -1)` has zero horizontal average. -/
theorem twoVertexMode_zeroHorizontalAverage :
    ZeroHorizontalAverage twoVertexBase
      (exponentialMode twoVertexBase (![1, -1] : Fin 2 → ℝ) (Real.arcosh 2) 0) := by
  have hf : ∑ x : Fin 2, (![1, -1] : Fin 2 → ℝ) x = 0 := by
    simp [Fin.sum_univ_two]
  intro y
  exact exponentialMode_sum_zero twoVertexBase (![1, -1] : Fin 2 → ℝ) (Real.arcosh 2) 0 hf y

/-- The mode of `(1, -1)` decays exponentially downwards at rate `arcosh 2 > 0`. -/
theorem twoVertexMode_expDecayBelow :
    ExpDecayBelow twoVertexBase
      (exponentialMode twoVertexBase (![1, -1] : Fin 2 → ℝ) (Real.arcosh 2) 0) := by
  unfold ExpDecayBelow
  refine ⟨∑ x : Fin 2, |(![1, -1] : Fin 2 → ℝ) x|, Real.arcosh 2,
    Real.arcosh_pos (by norm_num), fun p _ => ?_⟩
  unfold exponentialMode
  rw [sub_zero, abs_mul, abs_of_pos (Real.exp_pos _)]
  exact mul_le_mul_of_nonneg_right
    (Finset.single_le_sum (f := fun x : Fin 2 => |(![1, -1] : Fin 2 → ℝ) x|)
      (fun x _ => abs_nonneg _) (Finset.mem_univ p.1))
    (Real.exp_nonneg _)

/-- Nonvacuity, nonzero case: the mode of the zero-sum eigenvector `(1, -1)`
satisfies the three hypotheses, so `le_martingale_v2` applies to it. -/
example : MeasureTheory.Martingale
    (harmonicMartingale twoVertexBase
      (exponentialMode twoVertexBase (![1, -1] : Fin 2 → ℝ) (Real.arcosh 2) 0))
    (idlaFiltration twoVertexBase) (idlaMeasure twoVertexBase) :=
  le_martingale_v2 twoVertexBase _ twoVertexMode_harmonic
    twoVertexMode_zeroHorizontalAverage twoVertexMode_expDecayBelow

/-- The mode of `(1, -1)` is not the zero function, so the nonzero example is
not a disguised case of `ψ = 0`. -/
example : exponentialMode twoVertexBase (![1, -1] : Fin 2 → ℝ) (Real.arcosh 2) 0 ≠ 0 := by
  intro h
  have h1 := congrFun h ((0 : Fin 2), (0 : ℤ))
  simp [exponentialMode] at h1

end LeMartingaleV2Examples

end IdlaCyl.Frozen
