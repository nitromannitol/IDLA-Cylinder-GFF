module

/-
The settle site depends only on the first coordinates, measurably.

This is a prerequisite for the conditional law of the next settle site.
For `j < k`, `settleSite` at time `j` is a function of `ω 0, …, ω (k-1)`; more
precisely it is `comap`-measurable for the σ-algebra generated by the first `k`
trajectories.  The proof extends a finite tuple of trajectories to a full
`TrajSeq` (measurably) and uses `clusterTraj_congr`, which is the exact
statement that the cluster at time `j` depends only on the first `j` walks.
-/
public import IdlaCyl.Support.Filtration

@[expose] public section

namespace IdlaCyl

open MeasureTheory

variable (B : Base)

/-- Extend a finite tuple of trajectories to a full `TrajSeq` by repeating a
fixed trajectory in the remaining coordinates. -/
noncomputable def extendTuple (k : ℕ) (s : {i : ℕ // i < k} → (ℕ → Site B)) : TrajSeq B :=
  fun i => if h : i < k then s ⟨i, h⟩ else fun _ => (B.pt, 0)

theorem measurable_extendTuple (k : ℕ) : Measurable (extendTuple B k) := by
  refine measurable_pi_iff.mpr fun i => ?_
  by_cases h : i < k
  · have : (fun s : {i : ℕ // i < k} → (ℕ → Site B) => extendTuple B k s i)
        = fun s => s ⟨i, h⟩ := by
      funext s
      simp [extendTuple, h]
    rw [this]
    exact measurable_pi_apply _
  · have : (fun s : {i : ℕ // i < k} → (ℕ → Site B) => extendTuple B k s i)
        = fun _ => (fun _ => (B.pt, 0) : ℕ → Site B) := by
      funext s
      simp [extendTuple, h]
    rw [this]
    exact measurable_const

/-- The extension agrees with the original trajectory on the first `k`
coordinates. -/
@[simp]
theorem extendTuple_apply_of_lt {k : ℕ} (s : {i : ℕ // i < k} → (ℕ → Site B))
    {i : ℕ} (hi : i < k) : extendTuple B k s i = s ⟨i, hi⟩ := by
  simp [extendTuple, hi]

/-- `settleSite B · j` is measurable for the σ-algebra generated by the first
`k` trajectories, for `j < k`. -/
theorem measurable_settleSite_comap (k j : ℕ) (hj : j < k) :
    Measurable[MeasurableSpace.comap (fun ω : TrajSeq B => fun i : {i : ℕ // i < k} => ω i)
      inferInstance] (fun ω : TrajSeq B => settleSite B ω j) := by
  have hF : Measurable
      (fun s : {i : ℕ // i < k} → (ℕ → Site B) => settleSite B (extendTuple B k s) j) :=
    (measurable_settleSite B j).comp (measurable_extendTuple B k)
  have hproj : Measurable[MeasurableSpace.comap
      (fun ω : TrajSeq B => fun i : {i : ℕ // i < k} => ω i) inferInstance]
      (fun ω : TrajSeq B => fun i : {i : ℕ // i < k} => ω i) :=
    measurable_iff_comap_le.mpr le_rfl
  have hcomp := hF.comp hproj
  have heq : ((fun s : {i : ℕ // i < k} → (ℕ → Site B) => settleSite B (extendTuple B k s) j)
      ∘ (fun ω : TrajSeq B => fun i : {i : ℕ // i < k} => ω i))
      = fun ω : TrajSeq B => settleSite B ω j := by
    funext ω
    have hcongr : clusterTraj B (extendTuple B k (fun i : {i : ℕ // i < k} => ω i)) j
        = clusterTraj B ω j :=
      clusterTraj_congr B (fun i hi => by
        rw [extendTuple_apply_of_lt B _ (by omega)])
    have hval : (extendTuple B k (fun i : {i : ℕ // i < k} => ω i)) j = ω j :=
      extendTuple_apply_of_lt B _ hj
    show settleSite B (extendTuple B k (fun i : {i : ℕ // i < k} => ω i)) j = settleSite B ω j
    unfold settleSite
    rw [hcongr, hval]
  rw [heq] at hcomp
  exact hcomp

end IdlaCyl
