module

/-
The natural filtration of the canonical IDLA process.

`tex:884` and `tex:895-897`: the paper works with
`𝓕_k = σ(A(0),…,A(k))`, the σ-algebra generated by the cluster at the first `k`
release times, and observes that `(X_k,Y_k)`, the `k`-th settling location, is
`𝓕_k`-measurable.

On the canonical construction the cluster is a function of the settling sites
(`clusterTraj_eq_union`), so it is cleaner and equivalent almost
surely to define

  `idlaFiltration B k = ⨆ j < k, σ(settleSite B · j)`.

Two points are worth recording, because a careless "audit" statement would be
false rather than merely unproved.

* The index convention is strict: `𝓕_0 = ⊥` and `𝓕_k` contains exactly
  `z_0, …, z_(k-1)`.  `A(0) = R_0` is deterministic, so
  `σ(A(0),…,A(k)) = σ(z_0,…,z_(k-1))`.  An off-by-one here makes the
  martingale adapted to the wrong σ-algebra.
* The filtration generated by *membership events* `p ∈ A(j)` is strictly
  coarser on the null event where a walk never exits: `settleSite` then reads
  `WithTop.untopA ⊤ = Classical.arbitrary (Site B)` (`Support/Exit.lean`), and
  if that opaque site already lies in `A(j)`, adding it leaves `A(j+1) = A(j)`
  and the membership events do not reveal which site was chosen.  Since that
  event is null (`exitTraj_ae_finite`) and the martingale needs `settleSite`
  itself to be adapted, the settle-site filtration is the correct object; it
  is the one that makes `harmonicMartingale` adapted *everywhere*.
-/
public import IdlaCyl.Support.CanonicalMeas

@[expose] public section

namespace IdlaCyl

open MeasureTheory

variable (B : Base)

/-- `𝓕_k = σ(A(0),…,A(k))` (`tex:884`, `tex:895`), written through the settling
sites `z_0, …, z_(k-1)` (`tex:263-265`).  The index is strict:
`seq k = ⨆ j < k`, so `𝓕_0 = ⊥`. -/
noncomputable def idlaFiltration :
    Filtration ℕ (inferInstance : MeasurableSpace (TrajSeq B)) where
  seq k := ⨆ j < k, MeasurableSpace.comap (fun ω : TrajSeq B => settleSite B ω j) inferInstance
  mono' i j hij := by
    refine iSup₂_le fun m hm => ?_
    exact le_iSup₂ (f := fun m (_ : m < j) =>
        MeasurableSpace.comap (fun ω : TrajSeq B => settleSite B ω m) inferInstance)
      m (lt_of_lt_of_le hm hij)
  le' k := by
    refine iSup₂_le fun j _ => ?_
    exact (measurable_settleSite B j).comap_le

@[simp]
theorem idlaFiltration_apply (k : ℕ) :
    idlaFiltration B k
      = ⨆ j < k, MeasurableSpace.comap (fun ω : TrajSeq B => settleSite B ω j) inferInstance :=
  rfl

/-- **`𝓕_k` is the σ-algebra of the settle-site tuple** (`tex:884`, `tex:895`):
`σ(A(0),…,A(k)) = σ(z_0,…,z_(k-1))`, written as the comap of the tuple.  This is
the form in which the conditional law of the next settle site is computed. -/
theorem idlaFiltration_eq_comap_tuple (k : ℕ) :
    idlaFiltration B k
      = MeasurableSpace.comap
          (fun ω : TrajSeq B => fun j : {j : ℕ // j < k} => settleSite B ω j)
          inferInstance := by
  rw [MeasurableSpace.comap_process_pi, idlaFiltration_apply]
  exact iSup_subtype' (p := fun j : ℕ => j < k)
    (f := fun j (_ : j < k) =>
      MeasurableSpace.comap (fun ω : TrajSeq B => settleSite B ω j) inferInstance)

/-- The `k`-th settling site `z_k` is `𝓕_(k+1)`-measurable (`tex:896-897`).  It is not `𝓕_k`-measurable, which is the content of the strict index. -/
theorem measurable_settleSite_filtration (k : ℕ) :
    Measurable[idlaFiltration B (k + 1)] fun ω : TrajSeq B => settleSite B ω k := by
  rw [measurable_iff_comap_le]
  exact le_iSup₂ (f := fun j (_ : j < k + 1) =>
      MeasurableSpace.comap (fun ω : TrajSeq B => settleSite B ω j) inferInstance)
    k (Nat.lt_succ_self k)

/-- The `j`-th settling site is `𝓕_k`-measurable for every `j < k`. -/
theorem measurable_settleSite_filtration_of_lt {j k : ℕ} (h : j < k) :
    Measurable[idlaFiltration B k] fun ω : TrajSeq B => settleSite B ω j :=
  (measurable_settleSite_filtration B j).mono
    (Filtration.mono (idlaFiltration B) (Nat.succ_le_of_lt h)) le_rfl

/-- Membership of a fixed site in an earlier cluster is measurable in the
filtration (`tex:884`, `tex:895`): `A(j)` is `R_0` together with the
finitely many settling sites `z_0, …, z_(j-1)` (`clusterTraj_eq_union`). -/
theorem measurableSet_clusterTraj_filtration {j k : ℕ} (h : j ≤ k) (p : Site B) :
    MeasurableSet[idlaFiltration B k] {ω : TrajSeq B | p ∈ clusterTraj B ω j} := by
  have hset : {ω : TrajSeq B | p ∈ clusterTraj B ω j}
      = {ω : TrajSeq B | p ∈ R B 0} ∪
        ⋃ i ∈ Finset.range j, {ω : TrajSeq B | settleSite B ω i = p} := by
    ext ω
    simp only [Set.mem_setOf_eq]
    rw [clusterTraj_eq_union]
    simp only [Finset.mem_coe, Set.mem_setOf_eq, Set.mem_union, Finset.mem_image,
      Finset.mem_range, Set.mem_iUnion, exists_prop]
  rw [hset]
  refine MeasurableSet.union (MeasurableSet.const (p ∈ R B 0)) ?_
  refine MeasurableSet.biUnion (Finset.range j).countable_toSet fun i hi => ?_
  have hik : i < k := lt_of_lt_of_le (Finset.mem_range.mp hi) h
  exact (measurable_settleSite_filtration_of_lt B hik) (measurableSet_singleton p)

end IdlaCyl
