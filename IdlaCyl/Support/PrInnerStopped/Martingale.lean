/-
The stopped conditional mean, conditional second moment, and martingale property of the stopped
score (`paper/idla-cylinder-gff.tex:1189-1208`).

The conditioning σ-algebra is `stoppedFiltration B h`, generated by the stopped settle sites.  The
inherited `stoppedScoreOf_isMartingale` is stated for `idlaFiltration`, which is generated by the
unstopped settle sites and does not contain the stopped settle sites; the three hypotheses of that
statement are discharged here on `stoppedFiltration B h`.
-/
import IdlaCyl.Support.PrInnerStopped.Filtration
import IdlaCyl.Support.PrInnerStopped.ExitMean
import IdlaCyl.Support.StoppedScoreMartingale

namespace IdlaCyl

open MeasureTheory ProbabilityTheory Filter

/-- The algebraic core of the second-moment bound: `(x - c)^2 ≤ (1 - 2c) x + c^2` whenever
`x^2 ≤ x`, since the difference of the two sides is `x - x^2`. -/
theorem sq_sub_le_affine (x c : ℝ) (hx : x ^ 2 ≤ x) :
    (x - c) ^ 2 ≤ (1 - 2 * c) * x + c ^ 2 := by
  have key : (1 - 2 * c) * x + c ^ 2 - (x - c) ^ 2 = x - x ^ 2 := by ring
  linarith

variable (B : Base)

/-- The stopped hitting probability `H_ζ(X̄_k, Ȳ_k)` is bounded and measurable, hence integrable. -/
theorem integrable_hitProb_stoppedSettleSite (h : ℤ) (ζ : Site B) (k : ℕ) :
    Integrable (fun ω : TrajSeq B => hitProb B ζ (stoppedSettleSite B h ω k)) (idlaMeasure B) :=
  Integrable.of_bound
    ((measurable_of_countable (hitProb B ζ)).comp (measurable_stoppedSettleSite B h k)).aestronglyMeasurable
    1 (Filter.Eventually.of_forall fun ω => by
      rw [Real.norm_eq_abs, abs_of_nonneg (hitProb_nonneg B ζ _)]
      exact hitProb_le_one B ζ _)

/-- **Conditional mean of the stopped hitting probability** (`tex:1198-1202`): given the stopped
settle-site filtration, the next stopped settle site has `E[H_ζ] = 1/N`. -/
theorem condExp_hitProb_stoppedSettleSite (h : ℤ) (hh : 1 ≤ h) (ζ : Site B) (hζ : ζ.2 = h)
    (k : ℕ) :
    (idlaMeasure B)[fun ω : TrajSeq B => hitProb B ζ (stoppedSettleSite B h ω k)
        | stoppedFiltration B h k]
      =ᵐ[idlaMeasure B] fun _ => 1 / (B.card : ℝ) := by
  have hP2 := condExp_stoppedSettleSite_eq_integral B h k (hitProb B ζ)
    (measurable_of_countable (hitProb B ζ)).stronglyMeasurable
    (integrable_hitProb_stoppedSettleSite B h ζ k)
  have hle : (0 : ℝ) ≤ (h : ℝ) - 1 := by
    have : (1 : ℝ) ≤ (h : ℝ) := by exact_mod_cast hh
    linarith
  filter_upwards [hP2] with ω hω
  rw [hω]
  apply integral_hitProb_exitSite_uniform B ζ
  · rw [hζ]
    exact Set.inter_subset_right
  · intro q hq
    refine ⟨?_, R_mono hle hq⟩
    rw [stoppedCluster_eq_union]
    exact Set.mem_union_left _ hq

/-- **Conditional second moment of the centred stopped hitting probability** (`tex:1203-1208`):
`E[(H_ζ(X̄_k, Ȳ_k) - 1/N)^2 | 𝓖_k] ≤ 1/N - 1/N^2` almost surely. -/
theorem condExp_sq_stoppedSettleSite_le (h : ℤ) (hh : 1 ≤ h) (ζ : Site B) (hζ : ζ.2 = h)
    (k : ℕ) :
    (idlaMeasure B)[fun ω : TrajSeq B =>
        (hitProb B ζ (stoppedSettleSite B h ω k) - 1 / (B.card : ℝ)) ^ 2
        | stoppedFiltration B h k]
      ≤ᵐ[idlaMeasure B] fun _ => 1 / (B.card : ℝ) - (1 / (B.card : ℝ)) ^ 2 := by
  have hc0 : (0 : ℝ) ≤ 1 / (B.card : ℝ) := by positivity
  have hcardR : (2 : ℝ) ≤ (B.card : ℝ) := by exact_mod_cast B.nontrivial
  have hc1 : 1 / (B.card : ℝ) ≤ 1 := by
    rw [div_le_one (by linarith)]
    linarith
  have hgint := integrable_hitProb_stoppedSettleSite B h ζ k
  have hsq_int : Integrable (fun ω : TrajSeq B =>
      (hitProb B ζ (stoppedSettleSite B h ω k) - 1 / (B.card : ℝ)) ^ 2) (idlaMeasure B) := by
    refine Integrable.of_bound ?_ 1 (Filter.Eventually.of_forall fun ω => ?_)
    · exact ((((measurable_of_countable (hitProb B ζ)).comp
        (measurable_stoppedSettleSite B h k)).sub measurable_const).pow_const 2).aestronglyMeasurable
    · rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      have h0 := hitProb_nonneg B ζ (stoppedSettleSite B h ω k)
      have h1 := hitProb_le_one B ζ (stoppedSettleSite B h ω k)
      nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ 1 - hitProb B ζ (stoppedSettleSite B h ω k)
          + 1 / (B.card : ℝ))
        (by linarith : (0 : ℝ) ≤ 1 + hitProb B ζ (stoppedSettleSite B h ω k) - 1 / (B.card : ℝ))]
  have hf2_int : Integrable ((fun ω : TrajSeq B =>
      (1 - 2 * (1 / (B.card : ℝ))) * hitProb B ζ (stoppedSettleSite B h ω k))
      + fun _ : TrajSeq B => (1 / (B.card : ℝ)) ^ 2) (idlaMeasure B) :=
    (hgint.const_mul (1 - 2 * (1 / (B.card : ℝ)))).add (integrable_const _)
  have hpt : ∀ ω : TrajSeq B,
      (hitProb B ζ (stoppedSettleSite B h ω k) - 1 / (B.card : ℝ)) ^ 2
        ≤ (1 - 2 * (1 / (B.card : ℝ))) * hitProb B ζ (stoppedSettleSite B h ω k)
          + (1 / (B.card : ℝ)) ^ 2 := fun ω =>
    sq_sub_le_affine _ _ (hitProb_sq_le B ζ (stoppedSettleSite B h ω k))
  have hcm : (idlaMeasure B)[fun ω : TrajSeq B =>
        (hitProb B ζ (stoppedSettleSite B h ω k) - 1 / (B.card : ℝ)) ^ 2
        | stoppedFiltration B h k]
      ≤ᵐ[idlaMeasure B] (idlaMeasure B)[(fun ω : TrajSeq B =>
          (1 - 2 * (1 / (B.card : ℝ))) * hitProb B ζ (stoppedSettleSite B h ω k))
          + (fun _ : TrajSeq B => (1 / (B.card : ℝ)) ^ 2) | stoppedFiltration B h k] :=
    condExp_mono hsq_int hf2_int (Filter.Eventually.of_forall hpt)
  -- the conditional mean of the affine right-hand side
  have hA := condExp_add (m := stoppedFiltration B h k)
    (hgint.const_mul (1 - 2 * (1 / (B.card : ℝ)))) (integrable_const ((1 / (B.card : ℝ)) ^ 2))
  have hB : (idlaMeasure B)[fun ω : TrajSeq B =>
        (1 - 2 * (1 / (B.card : ℝ))) * hitProb B ζ (stoppedSettleSite B h ω k)
        | stoppedFiltration B h k]
      =ᵐ[idlaMeasure B] fun ω : TrajSeq B =>
        (1 - 2 * (1 / (B.card : ℝ))) * (idlaMeasure B)[fun ω : TrajSeq B =>
          hitProb B ζ (stoppedSettleSite B h ω k) | stoppedFiltration B h k] ω :=
    condExp_smul (1 - 2 * (1 / (B.card : ℝ)))
      (fun ω : TrajSeq B => hitProb B ζ (stoppedSettleSite B h ω k)) (stoppedFiltration B h k)
  have hD : (idlaMeasure B)[fun _ : TrajSeq B => (1 / (B.card : ℝ)) ^ 2
      | stoppedFiltration B h k] = fun _ => (1 / (B.card : ℝ)) ^ 2 :=
    condExp_const ((stoppedFiltration B h).le k) _
  have hC := condExp_hitProb_stoppedSettleSite B h hh ζ hζ k
  have hlin : (idlaMeasure B)[(fun ω : TrajSeq B =>
        (1 - 2 * (1 / (B.card : ℝ))) * hitProb B ζ (stoppedSettleSite B h ω k))
        + (fun _ : TrajSeq B => (1 / (B.card : ℝ)) ^ 2) | stoppedFiltration B h k]
      =ᵐ[idlaMeasure B] fun _ => (1 - 2 * (1 / (B.card : ℝ))) * (1 / (B.card : ℝ))
        + (1 / (B.card : ℝ)) ^ 2 := by
    filter_upwards [hA, hB, hC] with ω h1 h2 h3
    simp only [h1, h2, h3, hD, Pi.add_apply]
  filter_upwards [hcm, hlin] with ω h1 h2
  calc (idlaMeasure B)[fun ω : TrajSeq B =>
          (hitProb B ζ (stoppedSettleSite B h ω k) - 1 / (B.card : ℝ)) ^ 2
          | stoppedFiltration B h k] ω
      ≤ (idlaMeasure B)[(fun ω : TrajSeq B =>
          (1 - 2 * (1 / (B.card : ℝ))) * hitProb B ζ (stoppedSettleSite B h ω k))
          + (fun _ : TrajSeq B => (1 / (B.card : ℝ)) ^ 2) | stoppedFiltration B h k] ω := h1
    _ = (1 - 2 * (1 / (B.card : ℝ))) * (1 / (B.card : ℝ)) + (1 / (B.card : ℝ)) ^ 2 := h2
    _ = 1 / (B.card : ℝ) - (1 / (B.card : ℝ)) ^ 2 := by ring

/-- **The stopped score is a martingale for its settle-site filtration** (`tex:1189-1197`).
For the centred kernel `H_ζ - 1/N`, `stoppedScoreOf` is a martingale for `stoppedFiltration B h`.
This is `stoppedScoreOf_isMartingale` on the filtration of the stopped settle sites, with its
three hypotheses (`hadapted`, `hcond`, `hint`) discharged. -/
theorem stoppedScoreOf_isMartingale_stopped (h : ℤ) (hh : 1 ≤ h) (ζ : Site B) (hζ : ζ.2 = h) :
    Martingale (fun t ω => stoppedScoreOf B h (fun p => hitProb B ζ p - 1 / (B.card : ℝ)) t ω)
      (stoppedFiltration B h) (idlaMeasure B) := by
  classical
  have hint : ∀ t, Integrable (fun ω : TrajSeq B =>
      stoppedScoreOf B h (fun p => hitProb B ζ p - 1 / (B.card : ℝ)) t ω) (idlaMeasure B) := by
    intro t
    unfold stoppedScoreOf
    exact integrable_finsetSum _ fun s _ =>
      (integrable_hitProb_stoppedSettleSite B h ζ s).sub (integrable_const _)
  have hadapted : StronglyAdapted (stoppedFiltration B h)
      (fun t ω => stoppedScoreOf B h (fun p => hitProb B ζ p - 1 / (B.card : ℝ)) t ω) := by
    intro t
    have hm : Measurable[stoppedFiltration B h t] (fun ω : TrajSeq B =>
        stoppedScoreOf B h (fun p => hitProb B ζ p - 1 / (B.card : ℝ)) t ω) := by
      unfold stoppedScoreOf
      exact Finset.measurable_sum _ fun s hs =>
        ((measurable_of_countable (hitProb B ζ)).comp
          (measurable_stoppedSettleSite_filtration_of_lt B h (Finset.mem_range.mp hs))).sub
          measurable_const
    exact hm.stronglyMeasurable
  refine martingale_of_condExp_sub_eq_zero_nat hadapted hint ?_
  intro i
  have hstep : (fun ω : TrajSeq B =>
        stoppedScoreOf B h (fun p => hitProb B ζ p - 1 / (B.card : ℝ)) (i + 1) ω)
        - (fun ω : TrajSeq B =>
          stoppedScoreOf B h (fun p => hitProb B ζ p - 1 / (B.card : ℝ)) i ω)
      = fun ω : TrajSeq B => hitProb B ζ (stoppedSettleSite B h ω i) - 1 / (B.card : ℝ) := by
    funext ω
    simp only [Pi.sub_apply, stoppedScoreOf]
    rw [Finset.sum_range_succ]
    ring
  rw [hstep]
  have hsub : (idlaMeasure B)[fun ω : TrajSeq B =>
        hitProb B ζ (stoppedSettleSite B h ω i) - 1 / (B.card : ℝ) | stoppedFiltration B h i]
      =ᵐ[idlaMeasure B] (idlaMeasure B)[fun ω : TrajSeq B =>
          hitProb B ζ (stoppedSettleSite B h ω i) | stoppedFiltration B h i]
        - (idlaMeasure B)[fun _ : TrajSeq B => 1 / (B.card : ℝ) | stoppedFiltration B h i] :=
    condExp_sub (integrable_hitProb_stoppedSettleSite B h ζ i) (integrable_const _) _
  have hD : (idlaMeasure B)[fun _ : TrajSeq B => 1 / (B.card : ℝ) | stoppedFiltration B h i]
      = fun _ => 1 / (B.card : ℝ) :=
    condExp_const ((stoppedFiltration B h).le i) _
  have hC := condExp_hitProb_stoppedSettleSite B h hh ζ hζ i
  filter_upwards [hsub, hC] with ω h1 h2
  rw [h1, Pi.sub_apply, h2, hD]
  simp

end IdlaCyl
