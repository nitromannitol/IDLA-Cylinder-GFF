module

/-
The settle-site filtration of the stopped process `Ā_h` (`paper/idla-cylinder-gff.tex:1147-1158`).

The conditional mean of `H_ζ(X̄_t, Ȳ_t)` in `tex:1198-1202` is taken given the stopped history.
The filtration `idlaFiltration` is generated by the unstopped settle sites, which do not determine
the stopped settle sites `stoppedSettleSite B h · j`.  This file defines `stoppedFiltration B h k`,
the σ-algebra generated by `stoppedSettleSite B h · j` for `j < k`, and proves:

* the stopped cluster and the stopped settle sites are measurable for it;
* the next stopped settle site is independent of the past walks, so its conditional law given
  `stoppedFiltration B h k` is the uniform-start exit law from the current stopped cluster.
-/
public import IdlaCyl.Support.Stopped
public import IdlaCyl.Support.CondDistrib

@[expose] public section

namespace IdlaCyl

open MeasureTheory ProbabilityTheory

variable (B : Base)

/-- `Ā_h(t)` is `R_0` together with the stopped settle sites `X̄_j, Ȳ_j` for `j < t`. -/
theorem stoppedCluster_eq_union (h : ℤ) (ω : TrajSeq B) (t : ℕ) :
    stoppedCluster B h ω t
      = R B 0 ∪ ((Finset.range t).image (stoppedSettleSite B h ω) : Set (Site B)) := by
  induction t with
  | zero => simp [stoppedCluster]
  | succ n ih =>
    have hstep : stoppedCluster B h ω (n + 1)
        = stoppedCluster B h ω n ∪ {stoppedSettleSite B h ω n} := rfl
    rw [hstep, ih, Finset.range_add_one, Finset.image_insert]
    ext x
    simp only [Set.mem_union, Set.mem_singleton_iff, Finset.coe_insert, Set.mem_insert_iff]
    tauto

/-- The stopped cluster up to time `t` depends only on the first `t` walks. -/
theorem stoppedCluster_congr (h : ℤ) (ω ω' : TrajSeq B) (t : ℕ)
    (hω : ∀ j < t, ω j = ω' j) : stoppedCluster B h ω t = stoppedCluster B h ω' t := by
  induction t with
  | zero => rfl
  | succ n ih =>
    have hn : ∀ j < n, ω j = ω' j := fun j hj => hω j (by omega)
    have hωn : ω n = ω' n := hω n (by omega)
    show stoppedCluster B h ω n ∪ {exitSite' B (stoppedCluster B h ω n ∩ R B ((h : ℝ) - 1)) (ω n)}
      = stoppedCluster B h ω' n ∪
          {exitSite' B (stoppedCluster B h ω' n ∩ R B ((h : ℝ) - 1)) (ω' n)}
    rw [ih hn, hωn]

/-- The stopped settle site at time `t` depends only on the first `t + 1` walks. -/
theorem stoppedSettleSite_congr (h : ℤ) (ω ω' : TrajSeq B) (t : ℕ)
    (hω : ∀ j ≤ t, ω j = ω' j) : stoppedSettleSite B h ω t = stoppedSettleSite B h ω' t := by
  have hc : stoppedCluster B h ω t = stoppedCluster B h ω' t :=
    stoppedCluster_congr B h ω ω' t (fun j hj => hω j (le_of_lt hj))
  unfold stoppedSettleSite
  rw [hc, hω t le_rfl]

/-- If the first `t` stopped settle sites of `ω` are `s`, then the stopped cluster is `R_0 ∪ range s`. -/
theorem measurable_stoppedCluster_eq (h : ℤ) {t : ℕ} {ω : TrajSeq B} {s : Fin t → Site B}
    (hs : ∀ j : Fin t, stoppedSettleSite B h ω j = s j) :
    stoppedCluster B h ω t = R B 0 ∪ Set.range s := by
  rw [stoppedCluster_eq_union]
  congr 1
  ext p
  simp only [Finset.coe_image, Finset.coe_range, Set.mem_image, Set.mem_Iio, Set.mem_range]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, hj⟩, (hs ⟨j, hj⟩).symm⟩
  · rintro ⟨j, rfl⟩
    exact ⟨j, j.2, hs j⟩

/-- The stopped settle site `(X̄_t, Ȳ_t)` is a measurable function of the driving trajectories. -/
theorem measurable_stoppedSettleSite (h : ℤ) (t : ℕ) :
    Measurable fun ω : TrajSeq B => stoppedSettleSite B h ω t := by
  induction t using Nat.strong_induction_on with
  | _ t ih =>
    refine measurable_to_countable' fun q => ?_
    have hset : (fun ω : TrajSeq B => stoppedSettleSite B h ω t) ⁻¹' {q}
        = ⋃ s : Fin t → Site B,
            ({ω : TrajSeq B | ∀ j : Fin t, stoppedSettleSite B h ω j = s j} ∩
              {ω : TrajSeq B |
                exitSite' B ((R B 0 ∪ Set.range s) ∩ R B ((h : ℝ) - 1)) (ω t) = q}) := by
      ext ω
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_inter_iff,
        Set.mem_setOf_eq]
      constructor
      · intro hq
        refine ⟨fun j => stoppedSettleSite B h ω j, fun j => rfl, ?_⟩
        have hc := measurable_stoppedCluster_eq B h (t := t) (ω := ω)
          (s := fun j : Fin t => stoppedSettleSite B h ω j) (fun _ => rfl)
        rw [← hc]
        exact hq
      · rintro ⟨s, hs, hq⟩
        have hc := measurable_stoppedCluster_eq B h hs
        show exitSite' B (stoppedCluster B h ω t ∩ R B ((h : ℝ) - 1)) (ω t) = q
        rw [hc]
        exact hq
    rw [hset]
    refine MeasurableSet.iUnion fun s => MeasurableSet.inter ?_ ?_
    · have h1 : {ω : TrajSeq B | ∀ j : Fin t, stoppedSettleSite B h ω j = s j}
          = ⋂ j : Fin t, (fun ω : TrajSeq B => stoppedSettleSite B h ω j) ⁻¹' {s j} := by
        ext ω
        simp only [Set.mem_setOf_eq, Set.mem_iInter, Set.mem_preimage, Set.mem_singleton_iff]
      rw [h1]
      exact MeasurableSet.iInter fun j => ih (j : ℕ) j.isLt (measurableSet_singleton (s j))
    · exact ((measurable_exitSite' B ((R B 0 ∪ Set.range s) ∩ R B ((h : ℝ) - 1))).comp
        (measurable_pi_apply t)) (measurableSet_singleton q)

/-- **The settle-site filtration of the stopped process.**  `𝓖_k` is the σ-algebra generated by
the stopped settle sites `stoppedSettleSite B h · j` for `j < k`; the index is strict, so
`𝓖_0 = ⊥`. -/
noncomputable def stoppedFiltration (h : ℤ) :
    Filtration ℕ (inferInstance : MeasurableSpace (TrajSeq B)) where
  seq k :=
    ⨆ j < k, MeasurableSpace.comap (fun ω : TrajSeq B => stoppedSettleSite B h ω j) inferInstance
  mono' i j hij := by
    refine iSup₂_le fun m hm => ?_
    exact le_iSup₂ (f := fun m (_ : m < j) =>
        MeasurableSpace.comap (fun ω : TrajSeq B => stoppedSettleSite B h ω m) inferInstance)
      m (lt_of_lt_of_le hm hij)
  le' k := by
    refine iSup₂_le fun j _ => ?_
    exact (measurable_stoppedSettleSite B h j).comap_le

@[simp]
theorem stoppedFiltration_apply (h : ℤ) (k : ℕ) :
    stoppedFiltration B h k
      = ⨆ j < k, MeasurableSpace.comap (fun ω : TrajSeq B => stoppedSettleSite B h ω j)
          inferInstance :=
  rfl

/-- The `k`-th stopped settle site is `𝓖_(k+1)`-measurable. -/
theorem measurable_stoppedSettleSite_filtration (h : ℤ) (k : ℕ) :
    Measurable[stoppedFiltration B h (k + 1)] fun ω : TrajSeq B => stoppedSettleSite B h ω k := by
  rw [measurable_iff_comap_le]
  exact le_iSup₂ (f := fun j (_ : j < k + 1) =>
      MeasurableSpace.comap (fun ω : TrajSeq B => stoppedSettleSite B h ω j) inferInstance)
    k (Nat.lt_succ_self k)

/-- The `j`-th stopped settle site is `𝓖_k`-measurable for every `j < k`. -/
theorem measurable_stoppedSettleSite_filtration_of_lt (h : ℤ) {j k : ℕ} (hjk : j < k) :
    Measurable[stoppedFiltration B h k] fun ω : TrajSeq B => stoppedSettleSite B h ω j :=
  (measurable_stoppedSettleSite_filtration B h j).mono
    (Filtration.mono (stoppedFiltration B h) (Nat.succ_le_of_lt hjk)) le_rfl

/-- Membership of a fixed site in the stopped cluster `Ā_h(j)` is `𝓖_k`-measurable for `j ≤ k`. -/
theorem measurableSet_mem_stoppedCluster_filtration (h : ℤ) {j k : ℕ} (hjk : j ≤ k) (p : Site B) :
    MeasurableSet[stoppedFiltration B h k] {ω : TrajSeq B | p ∈ stoppedCluster B h ω j} := by
  have hset : {ω : TrajSeq B | p ∈ stoppedCluster B h ω j}
      = {ω : TrajSeq B | p ∈ R B 0} ∪
        ⋃ i ∈ Finset.range j, {ω : TrajSeq B | stoppedSettleSite B h ω i = p} := by
    ext ω
    simp only [Set.mem_setOf_eq]
    rw [stoppedCluster_eq_union]
    simp only [Finset.mem_coe, Set.mem_union, Finset.mem_image, Finset.mem_range,
      Set.mem_iUnion, exists_prop, Set.mem_setOf_eq]
  rw [hset]
  refine MeasurableSet.union (MeasurableSet.const (p ∈ R B 0)) ?_
  refine MeasurableSet.biUnion (Finset.range j).countable_toSet fun i hi => ?_
  have hik : i < k := lt_of_lt_of_le (Finset.mem_range.mp hi) hjk
  exact (measurable_stoppedSettleSite_filtration_of_lt B h hik) (measurableSet_singleton p)

/-- `𝓖_k` is the σ-algebra of the stopped settle-site tuple. -/
theorem stoppedFiltration_eq_comap_tuple (h : ℤ) (k : ℕ) :
    stoppedFiltration B h k
      = MeasurableSpace.comap
          (fun ω : TrajSeq B => fun j : {j : ℕ // j < k} => stoppedSettleSite B h ω j)
          inferInstance := by
  rw [MeasurableSpace.comap_process_pi, stoppedFiltration_apply]
  exact iSup_subtype' (p := fun j : ℕ => j < k)
    (f := fun j (_ : j < k) =>
      MeasurableSpace.comap (fun ω : TrajSeq B => stoppedSettleSite B h ω j) inferInstance)

/-- The stopped cluster `Ā_h(k)` is `R_0` together with the stopped settle-site tuple. -/
theorem stoppedCluster_eq_union_settleTuple (h : ℤ) (k : ℕ) (ω : TrajSeq B) :
    R B 0 ∪ Set.range (fun j : {j : ℕ // j < k} => stoppedSettleSite B h ω j)
      = stoppedCluster B h ω k := by
  have hc := measurable_stoppedCluster_eq B h (t := k) (ω := ω)
    (s := fun j : Fin k => stoppedSettleSite B h ω j) (fun _ => rfl)
  rw [hc]
  congr 1
  ext p
  simp only [Set.mem_range]
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨⟨j.1, j.2⟩, rfl⟩
  · rintro ⟨j, rfl⟩
    exact ⟨⟨j.1, j.2⟩, rfl⟩

/-- **The next stopped settle site is independent of the past walks.**  The tuple of stopped
settle sites `(stoppedSettleSite B h · j)_{j<k}` is independent of the `k`-th walk `ω k`. -/
theorem indep_stoppedSettleSite_omega (h : ℤ) (k : ℕ) :
    IndepFun (fun ω : TrajSeq B => fun j : {j : ℕ // j < k} => stoppedSettleSite B h ω j)
      (fun ω : TrajSeq B => ω k) (idlaMeasure B) := by
  have hraw : IndepFun
      (fun ω : TrajSeq B => fun i : {i : ℕ // i ∈ Finset.range k} => ω i)
      (fun ω : TrajSeq B => fun i : {i : ℕ // i ∈ ({k} : Finset ℕ)} => ω i)
      (idlaMeasure B) :=
    (iIndepFun_traj B).indepFun_finset (Finset.range k) {k}
      (by simp) (fun i => measurable_pi_apply i)
  let φ : ({i : ℕ // i ∈ Finset.range k} → (ℕ → Site B)) →
      ({j : ℕ // j < k} → Site B) :=
    fun s j => stoppedSettleSite B h
      (extendTuple B k (fun i : {i : ℕ // i < k} =>
        s (⟨i.1, Finset.mem_range.mpr i.2⟩ : {i : ℕ // i ∈ Finset.range k}))) j
  have hφ : Measurable φ := by
    dsimp only [φ]
    refine measurable_pi_iff.mpr fun j => ?_
    exact (measurable_stoppedSettleSite B h j).comp
      ((measurable_extendTuple B k).comp
        (measurable_pi_iff.mpr fun i =>
          measurable_pi_apply
            (⟨i.1, Finset.mem_range.mpr i.2⟩ : {i : ℕ // i ∈ Finset.range k})))
  let ψ : ({i : ℕ // i ∈ ({k} : Finset ℕ)} → (ℕ → Site B)) → (ℕ → Site B) :=
    fun t => t (⟨k, by simp⟩ : {i : ℕ // i ∈ ({k} : Finset ℕ)})
  have hψ : Measurable ψ := by
    dsimp only [ψ]
    exact measurable_pi_apply (⟨k, by simp⟩ : {i : ℕ // i ∈ ({k} : Finset ℕ)})
  have hleft : (φ ∘ fun ω : TrajSeq B => fun i : {i : ℕ // i ∈ Finset.range k} => ω i)
      = fun ω : TrajSeq B => fun j : {j : ℕ // j < k} => stoppedSettleSite B h ω j := by
    funext ω j
    dsimp only [φ, Function.comp_apply]
    show stoppedSettleSite B h (extendTuple B k (fun i : {i : ℕ // i < k} => ω i)) j
        = stoppedSettleSite B h ω j
    apply stoppedSettleSite_congr B h
    intro i hi
    exact extendTuple_apply_of_lt B _ (lt_of_le_of_lt hi j.2)
  have hright : (ψ ∘ fun ω : TrajSeq B => fun i : {i : ℕ // i ∈ ({k} : Finset ℕ)} => ω i)
      = fun ω : TrajSeq B => ω k := by
    funext ω
    dsimp only [ψ, Function.comp_apply]
  exact IndepFun.congr (hraw.comp hφ hψ)
    (Filter.Eventually.of_forall (fun ω => congrFun hleft ω))
    (Filter.Eventually.of_forall (fun ω => congrFun hright ω))

/-- **The conditional law of the next stopped walk given the stopped past.**  Under
`idlaMeasure B`, the regular conditional distribution of `ω k` given the stopped settle-site tuple
is a.s. the constant kernel `walkLawUniform B`. -/
theorem condDistrib_stoppedSettleSites_omega (h : ℤ) (k : ℕ) :
    condDistrib (fun ω : TrajSeq B => ω k)
      (fun ω : TrajSeq B => fun j : {j : ℕ // j < k} => stoppedSettleSite B h ω j)
      (idlaMeasure B)
      =ᵐ[(idlaMeasure B).map
        (fun ω : TrajSeq B => fun j : {j : ℕ // j < k} => stoppedSettleSite B h ω j)]
      fun _ => walkLawUniform B := by
  let X : TrajSeq B → ({j : ℕ // j < k} → Site B) := fun ω j => stoppedSettleSite B h ω j
  let Y : TrajSeq B → (ℕ → Site B) := fun ω => ω k
  change condDistrib Y X (idlaMeasure B)
    =ᵐ[Measure.map X (idlaMeasure B)] fun _ => walkLawUniform B
  have hX : Measurable X := measurable_pi_iff.mpr fun j => measurable_stoppedSettleSite B h j
  have hY : AEMeasurable Y (idlaMeasure B) := (measurable_pi_apply k).aemeasurable
  have hmapY : Measure.map Y (idlaMeasure B) = walkLawUniform B := by
    rw [idlaMeasure]
    exact Measure.infinitePi_map_eval _ k
  have hindep : IndepFun X Y (idlaMeasure B) := by
    simpa only [X, Y] using indep_stoppedSettleSite_omega B h k
  have hprod : Measure.map (fun ω => (X ω, Y ω)) (idlaMeasure B)
      = (Measure.map X (idlaMeasure B)).prod (Measure.map Y (idlaMeasure B)) :=
    IndepFun.map_prod_eq_prod_map_map hX.aemeasurable hY hindep
  have hκ : Measure.map (fun ω => (X ω, Y ω)) (idlaMeasure B)
      = Measure.map X (idlaMeasure B) ⊗ₘ Kernel.const _ (walkLawUniform B) := by
    rw [hprod, hmapY, Measure.compProd_const]
  have hres := condDistrib_ae_eq_of_measure_eq_compProd (μ := idlaMeasure B) X hY hκ
  have hconst : (⇑(Kernel.const ({j : ℕ // j < k} → Site B) (walkLawUniform B))
      : ({j : ℕ // j < k} → Site B) → Measure (ℕ → Site B)) = fun _ => walkLawUniform B :=
    funext fun x => Kernel.const_apply _ x
  rwa [hconst] at hres

/-- **The conditional-expectation form of the next stopped settle site.**  For an integrable
`f (stoppedSettleSite B h · k)`, the conditional expectation given `stoppedFiltration B h k` is the
integral of `f` at the exit site of an independent uniform-start walk from the stopped cluster
`stoppedCluster B h ω k ∩ R_{h-1}`. -/
theorem condExp_stoppedSettleSite_eq_integral (h : ℤ) (k : ℕ) (f : Site B → ℝ)
    (hf : StronglyMeasurable f)
    (hint : Integrable (fun ω : TrajSeq B => f (stoppedSettleSite B h ω k)) (idlaMeasure B)) :
    (idlaMeasure B)[fun ω : TrajSeq B => f (stoppedSettleSite B h ω k) | stoppedFiltration B h k]
      =ᵐ[idlaMeasure B]
      fun ω : TrajSeq B =>
        ∫ w : ℕ → Site B, f (exitSite' B (stoppedCluster B h ω k ∩ R B ((h : ℝ) - 1)) w)
          ∂(walkLawUniform B) := by
  let X : TrajSeq B → ({j : ℕ // j < k} → Site B) := fun ω j => stoppedSettleSite B h ω j
  let Y : TrajSeq B → (ℕ → Site B) := fun ω => ω k
  have hX : Measurable X := measurable_pi_iff.mpr fun j => measurable_stoppedSettleSite B h j
  have hY : AEMeasurable Y (idlaMeasure B) := (measurable_pi_apply k).aemeasurable
  -- the next stopped settle site as a function of the past tuple and the next walk
  let g : ({j : ℕ // j < k} → Site B) × (ℕ → Site B) → ℝ :=
    fun p => f (exitSite' B ((R B 0 ∪ Set.range p.1) ∩ R B ((h : ℝ) - 1)) p.2)
  have hg_meas : Measurable g := by
    refine measurable_of_Iio fun c => ?_
    have hset : g ⁻¹' Set.Iio c
        = ⋃ s : ({j : ℕ // j < k} → Site B),
            ({s} : Set ({j : ℕ // j < k} → Site B)) ×ˢ
              {w : ℕ → Site B |
                f (exitSite' B ((R B 0 ∪ Set.range s) ∩ R B ((h : ℝ) - 1)) w) < c} := by
      ext p
      simp only [Set.mem_preimage, Set.mem_Iio, Set.mem_iUnion, Set.mem_prod,
        Set.mem_singleton_iff, Set.mem_setOf_eq, g]
      constructor
      · intro hp
        exact ⟨p.1, rfl, hp⟩
      · rintro ⟨s, hs, hp⟩
        rw [← hs] at hp
        exact hp
    rw [hset]
    refine MeasurableSet.iUnion fun s => ?_
    exact MeasurableSet.prod (measurableSet_singleton s)
      ((measurableSet_Iio (a := c)).preimage
        (hf.measurable.comp
          (measurable_exitSite' B ((R B 0 ∪ Set.range s) ∩ R B ((h : ℝ) - 1)))))
  have hg_eq (ω : TrajSeq B) : g (X ω, Y ω) = f (stoppedSettleSite B h ω k) := by
    dsimp only [g, Y]
    rw [stoppedCluster_eq_union_settleTuple B h k ω]
    rfl
  have hint' : Integrable (fun ω : TrajSeq B => g (X ω, Y ω)) (idlaMeasure B) :=
    hint.congr (Filter.Eventually.of_forall fun ω => (hg_eq ω).symm)
  have hf_int : Integrable g (Measure.map (fun ω => (X ω, Y ω)) (idlaMeasure B)) :=
    (integrable_map_measure hg_meas.aestronglyMeasurable (hX.aemeasurable.prodMk hY)).mpr hint'
  have hcond := condExp_prod_ae_eq_integral_condDistrib'
    (μ := idlaMeasure B) (X := X) (Y := Y) (f := g) hX hY hf_int
  have hcd : condDistrib Y X (idlaMeasure B)
      =ᵐ[Measure.map X (idlaMeasure B)] fun _ => walkLawUniform B := by
    simpa only [X, Y] using condDistrib_stoppedSettleSites_omega B h k
  have hcd_pull : ∀ᵐ ω ∂(idlaMeasure B),
      condDistrib Y X (idlaMeasure B) (X ω) = walkLawUniform B :=
    ae_of_ae_map hX.aemeasurable hcd
  have hR : (fun ω : TrajSeq B =>
        ∫ y, g (X ω, y) ∂(condDistrib Y X (idlaMeasure B) (X ω)))
      =ᵐ[idlaMeasure B] (fun ω : TrajSeq B => ∫ y, g (X ω, y) ∂(walkLawUniform B)) := by
    filter_upwards [hcd_pull] with ω hω
    rw [hω]
  have hB : (fun ω : TrajSeq B => ∫ y, g (X ω, y) ∂(walkLawUniform B))
      =ᵐ[idlaMeasure B]
      (fun ω : TrajSeq B =>
        ∫ w, f (exitSite' B (stoppedCluster B h ω k ∩ R B ((h : ℝ) - 1)) w)
          ∂(walkLawUniform B)) := by
    filter_upwards with ω
    refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
    dsimp only [g]
    rw [stoppedCluster_eq_union_settleTuple B h k ω]
  have hmono : (idlaMeasure B)[fun ω : TrajSeq B => f (stoppedSettleSite B h ω k)
        | stoppedFiltration B h k]
      =ᵐ[idlaMeasure B]
      (idlaMeasure B)[fun ω : TrajSeq B => g (X ω, Y ω) |
        MeasurableSpace.comap X inferInstance] := by
    rw [stoppedFiltration_eq_comap_tuple B h k]
    exact condExp_congr_ae (Filter.Eventually.of_forall fun ω => (hg_eq ω).symm)
  exact hmono.trans (hcond.trans (hR.trans hB))

end IdlaCyl
